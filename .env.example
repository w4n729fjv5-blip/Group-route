# Copy this file to ".env" and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API
#
# These are PUBLIC (anon) values and are safe to ship in a client-side app.
# Because this app has no login, anyone with the app URL can read/write the
# data. Do NOT put the "service_role" secret key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
